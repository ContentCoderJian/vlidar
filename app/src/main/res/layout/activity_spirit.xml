<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:paddingStart="@dimen/main_margin_horizontal"
    android:paddingTop="@dimen/map_margin_top"
    android:paddingEnd="@dimen/main_margin_horizontal"
    android:paddingBottom="@dimen/timer_bottom_button_margin"
    tools:context=".ui.activity.RadarActivity">

    <ImageButton
        android:id="@+id/ib_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-15dp"
        android:layout_marginTop="-15dp"
        android:layout_marginEnd="-15dp"
        android:layout_marginBottom="-15dp"
        android:background="@null"
        android:padding="15dp"
        android:src="@drawable/timer_back_selector" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp">

        <com.vlidar.mobile.ui.view.SpiritLevelView
            android:id="@+id/spiritLevelView"
            android:layout_width="420dp"
            android:layout_height="420dp"
            android:layout_centerInParent="true"
            app:bubbleColor="#e03524"
            app:bubbleRadius="18dp"
            app:bubbleRuleColor="@color/colorTranslateWhite1"
            app:bubbleRuleRadius="20.5dp"
            app:bubbleRuleWidth="1dp"
            app:horizontalColor="#00ff00"
            app:limitCircleWidth="3dp"
            app:limitColor="@color/colorTranslateWhite1"
            app:limitRadius="119dp" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="30dp">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.5">

            <TextView
                android:id="@+id/tvv_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:gravity="center_horizontal"
                android:text="0°"
                android:textColor="#fff"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/tvl_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvv_vertical"
                android:layout_centerHorizontal="true"
                android:gravity="center_horizontal"
                android:text="垂直"
                android:textColor="@android:color/darker_gray"
                android:textSize="20sp" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_weight="0.5">

            <TextView
                android:id="@+id/tvv_horz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:gravity="center_horizontal"
                android:text="0°"
                android:textColor="#fff"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/tvl_horz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvv_horz"
                android:layout_centerHorizontal="true"
                android:gravity="center_horizontal"
                android:text="水平"
                android:textColor="@android:color/darker_gray"
                android:textSize="20sp" />
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>