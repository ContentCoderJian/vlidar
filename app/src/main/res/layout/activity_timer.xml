<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:paddingStart="@dimen/main_margin_horizontal"
    android:paddingTop="@dimen/map_margin_top"
    android:paddingEnd="@dimen/main_margin_horizontal"
    android:paddingBottom="@dimen/timer_bottom_button_margin"
    tools:context=".ui.activity.TimerActivity">

    <ImageButton
        android:id="@+id/ib_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-15dp"
        android:layout_marginTop="-15dp"
        android:layout_marginEnd="-15dp"
        android:layout_marginBottom="-15dp"
        android:background="@null"
        android:padding="15dp"
        android:src="@drawable/timer_back_selector" />

    <ImageButton
        android:id="@+id/ib_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="-15dp"
        android:layout_marginTop="-15dp"
        android:layout_marginEnd="-15dp"
        android:layout_marginBottom="-15dp"
        android:background="@null"
        android:padding="15dp"
        android:src="@drawable/timer_add_selector" />

    <com.vlidar.jrecyclerview.JRecycleView
        android:id="@+id/recycle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/ib_scan"
        android:layout_below="@id/ib_back"
        android:layout_marginTop="@dimen/timer_list_margin_top"
        android:layout_marginBottom="@dimen/timer_bottom_button_margin" />

    <ImageButton
        android:id="@+id/ib_scan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/timer_bottom_selector"
        android:src="@drawable/scan_white" />

</RelativeLayout>