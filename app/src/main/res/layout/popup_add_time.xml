<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_timer_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/rl_duck_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/main_margin_horizontal"
        android:layout_marginEnd="@dimen/main_margin_horizontal"
        android:layout_marginBottom="@dimen/main_margin_horizontal"
        android:background="@drawable/duck_bar">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/common_button_padding"
            android:paddingTop="@dimen/timer_button_margin_top"
            android:paddingEnd="@dimen/common_button_padding"
            android:paddingBottom="@dimen/common_button_padding"
            android:text="@string/cancel"
            android:textColor="@drawable/bottom_button_text_selector"
            android:textSize="@dimen/bottom_button_text_size" />

        <Button
            android:id="@+id/btn_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/common_button_padding"
            android:paddingTop="@dimen/timer_button_margin_top"
            android:paddingEnd="@dimen/common_button_padding"
            android:paddingBottom="@dimen/common_button_padding"
            android:text="@string/done"
            android:textColor="@drawable/bottom_button_text_selector"
            android:textSize="@dimen/bottom_button_text_size" />

        <ImageView
            android:id="@+id/iv_black_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_done"
            android:background="@drawable/black_line" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_black_line"
            android:layout_centerHorizontal="true"
            app:tabGravity="center"
            app:tabIndicator="@drawable/white_focus_line"
            app:tabIndicatorColor="@color/colorWhite"
            app:tabIndicatorFullWidth="false"
            app:tabMinWidth="96dp"
            app:tabMode="fixed"
            app:tabPaddingBottom="10dp"
            app:tabPaddingEnd="16dp"
            app:tabPaddingStart="16dp"
            app:tabPaddingTop="@dimen/common_button_padding"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="@color/colorWhite"
            app:tabTextAppearance="@style/TabLayoutTextStyle"
            app:tabTextColor="@color/colorWhite" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tab_layout"
            android:layout_marginTop="@dimen/wheel_margin_top"
            android:orientation="horizontal">

            <com.vlidar.wheelview.widget.WheelView
                android:id="@+id/hour_wheel_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.vlidar.wheelview.widget.WheelView
                android:id="@+id/minute_wheel_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.vlidar.wheelview.widget.WheelView
                android:id="@+id/second_wheel_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>