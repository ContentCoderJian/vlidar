<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".ui.activity.MainActivity">

    <RelativeLayout
        android:id="@+id/rl_map_with_button"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/rl_scan_once">

        <com.amap.api.maps.TextureMapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="@dimen/map_height"
            android:layout_marginStart="@dimen/main_margin_horizontal"
            android:layout_marginTop="@dimen/map_margin_top"
            android:layout_marginEnd="@dimen/main_margin_horizontal"
            android:background="@drawable/map" />

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/map"
            android:layout_marginStart="@dimen/main_margin_horizontal"
            android:layout_marginTop="@dimen/logo_margin_top"
            android:src="@drawable/logo_min" />

        <!--        <TextView
                    android:id="@+id/tv_self_checking_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/iv_logo"
                    android:layout_marginStart="@dimen/main_margin_horizontal"
                    android:layout_marginTop="@dimen/check_status_margin_top"
                    android:src="@drawable/logo_min"
                    android:text="自检完成"
                    android:textColor="@color/colorGrey"
                    android:textSize="@dimen/check_status_text_size" />-->

        <RelativeLayout
            android:id="@+id/rl_show_hide_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/map"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/main_margin_horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_latitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/latitude_margin_top"
                android:layout_marginEnd="@dimen/latitude_longitude_margin_end"
                android:src="@drawable/logo_min"
                android:text="0°0'0&quot;N"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/latitude_longitude_text_size"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_longitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_latitude"
                android:layout_marginTop="@dimen/longitude_margin_top"
                android:layout_marginEnd="@dimen/latitude_longitude_margin_end"
                android:src="@drawable/logo_min"
                android:text="0°0'0&quot;E"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/latitude_longitude_text_size"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_no_gps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.5dp"
                android:layout_marginEnd="@dimen/latitude_longitude_margin_end"
                android:layout_marginBottom="-8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:src="@drawable/logo_min"
                android:text="@string/no_gps"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/latitude_longitude_text_size" />

            <ImageButton
                android:id="@+id/ib_up_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/logo_margin_top"
                android:layout_toEndOf="@id/tv_no_gps"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:src="@drawable/down" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_common_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_logo"
            android:layout_marginStart="@dimen/main_margin_horizontal"
            android:layout_marginTop="@dimen/button_margin_top"
            android:layout_marginEnd="@dimen/main_margin_horizontal">

            <com.vlidar.mobile.ui.view.CommonButton
                android:id="@+id/cb_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/common_button_selector" />

            <com.vlidar.mobile.ui.view.CommonButton
                android:id="@+id/cb_radar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:background="@drawable/common_button_selector" />

            <com.vlidar.mobile.ui.view.CommonButton
                android:id="@+id/cb_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/common_button_selector"
                tools:ignore="RelativeOverlap" />

        </RelativeLayout>

        <com.vlidar.mobile.ui.view.CommonButton
            android:id="@+id/cb_imu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/rl_common_button"
            android:layout_marginStart="@dimen/main_margin_horizontal"
            android:layout_marginTop="@dimen/common_button_margin_top"
            android:background="@drawable/common_button_selector" />

        <com.vlidar.mobile.ui.view.CommonButton
            android:id="@+id/cb_timer_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/rl_common_button"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/common_button_margin_top"
            android:background="@drawable/common_button_selector" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_scan_once"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/main_margin_horizontal"
        android:layout_marginEnd="@dimen/main_margin_horizontal"
        android:layout_marginBottom="@dimen/button_margin_bottom"
        android:background="@drawable/bottom_button_selector">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_once_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clickable="false"
                android:src="@drawable/once_scan_button_selector" />

            <TextView
                android:id="@+id/tv_scan_once"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/bottom_button_margin_icon"
                android:clickable="false"
                android:text="@string/scan_once"
                android:textColor="@drawable/common_button_title_text_selector"
                android:textSize="@dimen/bottom_button_text_size" />
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>