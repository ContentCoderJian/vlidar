<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".ui.MainActivity">

    <com.amap.api.maps.TextureMapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="@dimen/map_height"
        android:layout_marginStart="@dimen/main_margin_horizontal"
        android:layout_marginTop="@dimen/map_margin_top"
        android:layout_marginEnd="@dimen/main_margin_horizontal"
        android:background="@drawable/map" />

    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/map"
        android:layout_marginStart="@dimen/main_margin_horizontal"
        android:layout_marginTop="@dimen/logo_margin_top"
        android:src="@drawable/logo_min" />

    <TextView
        android:id="@+id/tv_self_checking_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/iv_logo"
        android:layout_marginStart="@dimen/main_margin_horizontal"
        android:layout_marginTop="@dimen/check_status_margin_top"
        android:src="@drawable/logo_min"
        android:text="自检完成"
        android:textColor="@color/colorGrey"
        android:textSize="@dimen/check_status_text_size" />

    <ImageButton
        android:id="@+id/ib_up_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/map"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/logo_margin_top"
        android:layout_marginEnd="@dimen/main_margin_horizontal"
        android:background="@android:color/transparent"
        android:src="@drawable/down" />

    <TextView
        android:id="@+id/tv_latitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/map"
        android:layout_marginTop="@dimen/latitude_margin_top"
        android:layout_marginEnd="@dimen/latitude_longitude_margin_end"
        android:layout_toStartOf="@id/ib_up_down"
        android:src="@drawable/logo_min"
        android:text="31°55'46.8192&quot;N"
        android:textColor="@color/colorWhite"
        android:textSize="@dimen/latitude_longitude_text_size" />

    <TextView
        android:id="@+id/tv_longitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_latitude"
        android:layout_marginTop="@dimen/longitude_margin_top"
        android:layout_marginEnd="@dimen/latitude_longitude_margin_end"
        android:layout_toStartOf="@id/ib_up_down"
        android:src="@drawable/logo_min"
        android:text="118°49'12.2988&quot;E"
        android:textColor="@color/colorWhite"
        android:textSize="@dimen/latitude_longitude_text_size" />

</RelativeLayout>